{
  "name": "kaki",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "start": "bash scripts/live-up.sh",
    "stop": "bash scripts/live-down.sh",
    "live:up": "bash scripts/live-up.sh",
    "live:down": "bash scripts/live-down.sh",
    "cloud:up": "bash scripts/cloud.sh up",
    "cloud:down": "bash scripts/cloud.sh down",
    "cloud:status": "bash scripts/cloud.sh status",
    "dev": "node scripts/dev.mjs",
    "npc": "npm run npc -w @kaki/server",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "llm:use": "tsx scripts/llm-use.ts",
    "eval:notetaker": "tsx server/src/host/evalNotetaker.ts",
    "eval:ami:convert": "tsx server/src/host/eval/convertAmi.ts",
    "eval:key": "tsx scripts/eval-key-judge.ts",
    "playtest:dialogue": "tsx scripts/playtest-dialogue.ts",
    "stack:up": "docker compose -f docker/docker-compose.yml up -d",
    "stack:down": "docker compose -f docker/docker-compose.yml down",
    "seed": "tsx docker/seed/index.ts",
    "seed:verify": "tsx docker/verify.ts",
    "index:knowledge": "tsx server/src/wingman/knowledge/cli.ts",
    "host:create": "tsx server/src/auth/cli.ts",
    "meeting:reset": "bash scripts/meeting-reset.sh",
    "knowledge:check": "tsx server/src/wingman/knowledge/check.ts"
  },
  "dependencies": {
    "@kaki/shared": "*",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "playwright": "^1.65.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
