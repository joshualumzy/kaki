# Copy to docker/.env or let `npm run seed` create it.
# Everything here is a dev-only dummy. Never put real credentials in this repo.

SCENARIO=kopitiam

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=kaki
POSTGRES_USER=kaki
POSTGRES_PASSWORD=kaki_dev_password
POSTGRES_URL=postgres://kaki:kaki_dev_password@127.0.0.1:5433/kaki

WIKI_URL=http://127.0.0.1:8081
WIKI_ADMIN_EMAIL=admin@nanyangkopitiam.example
WIKI_ADMIN_PASSWORD=kaki_wiki_dev

GITEA_URL=http://127.0.0.1:8082
GITEA_ADMIN_USER=wei-ling
GITEA_ADMIN_PASSWORD=kaki_gitea_dev
GITEA_ADMIN_EMAIL=admin@nanyangkopitiam.example
GITEA_ORG=kopitiam
GITEA_REPO=kopitiam-pos
# Generated by `npm run seed`; the dummy below is only a placeholder.
GITEA_TOKEN=replace-me

MATTERMOST_URL=http://127.0.0.1:8083
MATTERMOST_ADMIN_USER=weiling
MATTERMOST_ADMIN_EMAIL=wei.ling@nanyangkopitiam.example
MATTERMOST_PASSWORD=kaki_mattermost_dev
MATTERMOST_TEAM=kopitiam
# Generated by `npm run seed`; the dummy below is only a placeholder.
MATTERMOST_TOKEN=replace-me

MAILPIT_URL=http://127.0.0.1:8084
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025

# Company search (school gateway). Copy these into the shell that runs the server:
# export KAKI_LLM_BASE_URL=... KAKI_LLM_API_KEY=...
KAKI_LLM_BASE_URL=https://gateway.example/v1
KAKI_LLM_API_KEY=replace-me
KAKI_LLM_MODEL=x-test-2
KAKI_EMBED_MODEL=bge-m3
