# Installed on the VM as /etc/systemd/system/kaki-backup.service (see deploy/backup/README.md).
[Unit]
Description=Kaki nightly Postgres backup
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=KAKI_APP_DIR=/home/azureuser/app
# Optional overrides: KAKI_APP_DIR, KAKI_BACKUP_DIR, KAKI_BACKUP_KEEP_DAYS, KAKI_ENV_FILE,
# KAKI_COMPOSE_FILE.
EnvironmentFile=-/etc/kaki-backup.env
ExecStart=/bin/bash /usr/local/bin/kaki-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
