{"fps":30,"width":1920,"height":1080,"bpm":115.02,"beatPhaseSeconds":0.03,"durationFrames":4893,"durationSeconds":163.1,"lines":[{"id":"raj-groan","voice":"raj","speaker":"Raj","text":"","sourceSeconds":1.2523125,"playbackRate":1,"startFrame":174,"endFrame":212,"durFrames":38,"amp":"46689987987777766644332222211111111111","start":5.8,"end":7.0667},{"id":"vo-open","voice":"narrator","speaker":"Narrator","text":"Monday. Again. Thirty minutes to sort out the whole week.","sourceSeconds":4.74,"playbackRate":1,"startFrame":236,"endFrame":379,"durFrames":143,"amp":"","start":7.8667,"end":12.6333},{"id":"mei1","voice":"mei","speaker":"Mei","text":"Raj, when does our packaging contract end? If it auto-renews, we're stuck with the new prices.","sourceSeconds":7.080145833333333,"playbackRate":1,"startFrame":515,"endFrame":728,"durFrames":213,"amp":"125997675121221000000000000003333339998544425983289971123773112233421255432255301005665542222221000000000166213610007978982698631222222223222221210000000011366422333203995100026510043444552001236754232332111221000","start":17.1667,"end":24.2667},{"id":"raj1","voice":"raj","speaker":"Raj","text":"Uh... let me check.","sourceSeconds":3.4646875,"playbackRate":1,"startFrame":742,"endFrame":846,"durFrames":104,"amp":"00007864210000000000000000000000000000000000000000058998810039999810238511000000000000000000000000000000","start":24.7333,"end":28.2},{"id":"mei2","voice":"mei","speaker":"Mei","text":"So who's emailing them about the renewal?","sourceSeconds":2.7842291666666665,"playbackRate":1,"startFrame":860,"endFrame":944,"durFrames":84,"amp":"001342995520000000011125556332001478989998655433353357229983002213333356775322010000","start":28.6667,"end":31.4667},{"id":"mei-later","voice":"mei","speaker":"Mei","text":"...Okay. We'll come back to it.","sourceSeconds":1.8397083333333333,"playbackRate":1,"startFrame":1019,"endFrame":1075,"durFrames":56,"amp":"79214786433331000000000002452014765599741001134333211100","start":33.9667,"end":35.8333},{"id":"aisha1","voice":"aisha","speaker":"Aisha","text":"Sorry, what did I miss?","sourceSeconds":1.6570833333333332,"playbackRate":1,"startFrame":1101,"endFrame":1151,"durFrames":50,"amp":"24538998855332000000027950038617765455432134432100","start":36.7,"end":38.3667},{"id":"mei-moveon","voice":"mei","speaker":"Mei","text":"...Never mind. Let's just move on.","sourceSeconds":2.448541666666667,"playbackRate":1,"startFrame":1175,"endFrame":1249,"durFrames":74,"amp":"36999524433433322223210000000000000000001278201343331998775249762321111100","start":39.1667,"end":41.6333},{"id":"vo-weeks","voice":"narrator","speaker":"Narrator","text":"Week after week, it slides... until the contract renews itself. At the new prices.","sourceSeconds":6.36,"playbackRate":1,"startFrame":1353,"endFrame":1544,"durFrames":191,"amp":"","start":45.1,"end":51.4667},{"id":"vo-bridge","voice":"narrator","speaker":"Narrator","text":"We kept seeing this. So we built Kaki: it sits in your meeting, helps everyone keep up, and actually gets the work done.","sourceSeconds":7.7,"playbackRate":1,"startFrame":1655,"endFrame":1886,"durFrames":231,"amp":"","start":55.1667,"end":62.8667},{"id":"mei1b","voice":"mei","speaker":"Mei","text":"Raj, when does our packaging contract end?","sourceSeconds":2.8935416666666667,"playbackRate":1,"startFrame":1902,"endFrame":1989,"durFrames":87,"amp":"248998742111110000000000001489973325642499721227730251133442135652234420016765522221000","start":63.4,"end":66.3},{"id":"vo-answer","voice":"narrator","speaker":"Narrator","text":"This time, Raj doesn't have to check. Kaki's already found it in the team's wiki, and only Raj can see it.","sourceSeconds":6.5,"playbackRate":1,"startFrame":2021,"endFrame":2216,"durFrames":195,"amp":"","start":67.3667,"end":73.8667},{"id":"raj2","voice":"raj","speaker":"Raj","text":"March 31st. We need to give notice by end of January.","sourceSeconds":5.875,"playbackRate":1,"startFrame":2230,"endFrame":2407,"durFrames":177,"amp":"000389989981022000017893057311474111220000000000000000000000000000022899889799997410037522699521466778610897332135765552004777846652101247644544542211000000000000000000000000000","start":74.3333,"end":80.2333},{"id":"raj3","voice":"raj","speaker":"Raj","text":"I'll email them this week.","sourceSeconds":2.6,"playbackRate":1,"startFrame":2443,"endFrame":2521,"durFrames":78,"amp":"000478888741038899999999842287778841683222025531000000000000000000000000000000","start":81.4333,"end":84.0333},{"id":"vo-whywait","voice":"narrator","speaker":"Narrator","text":"Hold on, Raj. This week? Why wait?","sourceSeconds":2.9,"playbackRate":1,"startFrame":2533,"endFrame":2620,"durFrames":87,"amp":"","start":84.4333,"end":87.3333},{"id":"vo-task","voice":"narrator","speaker":"Narrator","text":"Kaki spots what you've agreed on and turns it into a task. Mei's running the meeting, so she picks who takes it.","sourceSeconds":6.01,"playbackRate":1,"startFrame":2632,"endFrame":2813,"durFrames":181,"amp":"","start":87.7333,"end":93.7667},{"id":"vo-draft","voice":"narrator","speaker":"Narrator","text":"Kaki writes the draft. Raj adds his own touch...","sourceSeconds":3.06,"playbackRate":1,"startFrame":2941,"endFrame":3033,"durFrames":92,"amp":"","start":98.0333,"end":101.1},{"id":"vo-sent","voice":"narrator","speaker":"Narrator","text":"Raj approves. Sent, before the call's even over.","sourceSeconds":3.62,"playbackRate":1,"startFrame":3111,"endFrame":3220,"durFrames":109,"amp":"","start":103.7,"end":107.3333},{"id":"vo-nudge","voice":"narrator","speaker":"Narrator","text":"This touches Aisha's catering, but she hasn't said a word. So Kaki catches her up, with something she could add.","sourceSeconds":6.26,"playbackRate":1,"startFrame":3271,"endFrame":3459,"durFrames":188,"amp":"","start":109.0333,"end":115.3},{"id":"aisha2","voice":"aisha","speaker":"Aisha","text":"If we switch suppliers, I'll need two weeks' notice for catering.","sourceSeconds":3.7313541666666667,"playbackRate":1,"startFrame":3512,"endFrame":3624,"durFrames":112,"amp":"8611157599616860477758500499976665535765200000000159877799310145986468610598246666114648610274101475113322221100","start":117.0667,"end":120.8},{"id":"mei-goodpoint","voice":"mei","speaker":"Mei","text":"Good catch, Aisha.","sourceSeconds":1.4035625,"playbackRate":1,"startFrame":3640,"endFrame":3683,"durFrames":43,"amp":"2992101123899510122211000006678665222122100","start":121.3333,"end":122.7667},{"id":"vo-tools","voice":"narrator","speaker":"Narrator","text":"And not just email. Chat... GitHub... calendar... wiki. Kaki drafts, you approve.","sourceSeconds":6.5,"playbackRate":1,"startFrame":3739,"endFrame":3934,"durFrames":195,"amp":"","start":124.6333,"end":131.1333},{"id":"vo-end-minutes","voice":"narrator","speaker":"Narrator","text":"That's the meeting, on time. And the minutes are already written. Mei gives them a once-over, and they're on the wiki.","sourceSeconds":6.42,"playbackRate":1,"startFrame":3978,"endFrame":4171,"durFrames":193,"amp":"","start":132.6,"end":139.0333},{"id":"vo-next","voice":"narrator","speaker":"Narrator","text":"So next Monday starts where this one left off.","sourceSeconds":2.98,"playbackRate":1,"startFrame":4393,"endFrame":4483,"durFrames":90,"amp":"","start":146.4333,"end":149.4333},{"id":"mei-jade","voice":"mei","speaker":"Mei","text":"Raj, what did Jade say?","sourceSeconds":1.6854375,"playbackRate":1,"startFrame":4511,"endFrame":4562,"durFrames":51,"amp":"237998884421111575002543238998741232288776543320000","start":150.3667,"end":152.0667},{"id":"raj-jade","voice":"raj","speaker":"Raj","text":"Sorted, boss. They're keeping the old prices.","sourceSeconds":3.68,"playbackRate":1,"startFrame":4574,"endFrame":4685,"durFrames":111,"amp":"000001188741066662100001228731011211000000000001279988853000378710899894387200489999422003864322121101211000000","start":152.4667,"end":156.1667}],"events":{"buzz":20,"phonePush":36,"phonePushEnd":66,"phoneBack":108,"phoneBackEnd":138,"sigh1":104,"mugDown":120,"rajShot":144,"aishaShot":216,"meiShot4":276,"reach":405,"lidStart":417,"lidEnd":445,"pushStart":449,"pushEnd":489,"gridIn":489,"silenceStart":944,"stepOut":782,"stepBack":1079,"rajRoll":1199,"rub":1257,"pullStart":1317,"pullEnd":1353,"tears":[1362,1378,1393,1409],"stickies":[1370,1386,1401,1417],"envIn":1425,"flapOpen":1449,"letterUp":1455,"letterPush":1459,"letterReady":1493,"faceIn":1518,"faceFace":1542,"rewind":1600,"rewindPages":[1622,1630,1638,1646],"rewindNotes":[1624,1630,1636,1642],"rewindEnv":1618,"push2Start":1686,"push2End":1716,"grid2":1716,"cup":[1722,1738,1753],"warmStart":1718,"bridgeEnd":1886,"answerGlow":1992,"answerLayout":1995,"answerIn":2051,"answerOut":2415,"lift":2634,"liftLand":2690,"pickOpen":2744,"pickChoose":2770,"sendTap":2817,"glideStart":2827,"chipLand":2863,"rajGlow":2861,"taskIn":2901,"acceptTap":2981,"draftIn":2995,"editStart":3031,"editEnd":3081,"approveTap":3119,"foldStart":3123,"fly":3151,"flyEnd":3185,"sent":3177,"s7End":3257,"nudgeStart":3257,"hesitate":3279,"glow3":3371,"aishaLayout":3375,"catchupIn":3431,"nowRow":3422,"pointIn":3462,"unmute":3496,"lean":3504,"catchupOut":3632,"s8End":3723,"tools":3723,"toolWord":[3783,3806,3828,3852],"toolArrive":[3797,3820,3842,3866],"s9End":3958,"callEnd":3958,"endTap":3992,"confirmShow":4000,"confirmTap":4034,"dark":[4042,4054,4066],"ended":4080,"minutesIn":4086,"minutesTick":4104,"minutesApprove":4128,"published":4140,"wikiTap":4160,"pullBack":4176,"wikiSwap":4180,"pullBackEnd":4221,"wikiPush":4225,"wikiPushEnd":4255,"rowIn":4259,"s10End":4345,"nextBuzz":4383,"nextReach":4433,"nextLid":4441,"nextLidEnd":4461,"nextPush":4463,"nextPushEnd":4487,"endCard":4743},"sfxFrames":{"buzz":12,"card":7,"click":4,"creak":10,"crease":6,"flap":4,"flutter":22,"glint":19,"join":13,"mei-sigh":58,"mug":4,"murmur":49,"off":5,"pen":4,"puff":16,"raj-groan":50,"rip0":6,"rip1":6,"rip2":6,"rip3":6,"roomtone":361,"sent":22,"settle":4,"slide":11,"sticky":3,"thud":6,"tok":4,"typing":52,"whoosh0":13,"whoosh1":13,"whoosh