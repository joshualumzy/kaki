# Copy to .env: the server loads it on start, and variables already set in the shell win.
PORT=3001
# KAKI_DEV_ROUTES=1  # npm run dev already turns the /dev routes on; never set this for the demo server

# Shared LLM client (OpenAI-compatible, e.g. the school gateway). Leave unset to run without an LLM.
KAKI_LLM_BASE_URL=
KAKI_LLM_API_KEY=
KAKI_LLM_MODEL=
# KAKI_LLM_TIMEOUT_MS=20000

# Host: play scenarios/<id>/replay/transcript.json instead of live audio, optionally sped up.
# KAKI_REPLAY=1
# KAKI_REPLAY_SPEED=10
# KAKI_NOTETAKER_INTERVAL_MS=7000

# Action: Gitea issues Kaki files after approval. Without all four, a Gitea task fails with a clear message.
# The values come from docker/.env after `npm run seed` (GITEA_TOKEN is generated there).
GITEA_URL=
GITEA_TOKEN=
GITEA_ORG=
GITEA_REPO=

# Action: Mattermost posts Kaki sends after approval. Without all four, a Mattermost task fails with a clear message.
# The values come from docker/.env after `npm run seed` (MATTERMOST_TOKEN is generated there); channel is e.g. launch.
MATTERMOST_URL=
MATTERMOST_TOKEN=
MATTERMOST_TEAM=
MATTERMOST_CHANNEL=

# Action: emails Kaki sends after approval through the local Mailpit stack. Without all four, an email task fails with a clear message.
# The first three match the demo stack; EMAIL_FROM is the address Kaki sends from.
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_URL=http://127.0.0.1:8084
EMAIL_FROM=kaki@pixelkampung.example

# Action: wiki pages Kaki publishes after approval (Wiki.js from the demo stack). Without all three, a wiki task fails with a clear message.
WIKI_URL=http://127.0.0.1:8081
WIKI_ADMIN_EMAIL=admin@pixelkampung.example
WIKI_ADMIN_PASSWORD=kaki_wiki_dev

# Action: calendar events Kaki saves after approval (mock Radicale from the demo stack, no login, nothing real).
# People open an event at KAKI_PUBLIC_URL (or http://127.0.0.1:$PORT) + /api/calendar/<id>.
CALDAV_URL=http://127.0.0.1:5232

# Live demo meeting (`/demo`): the AI attendees run with `npm run npc`. They need the LLM above and Azure speech.
# AZURE_SPEECH_KEY
# AZURE_SPEECH_REGION
# LiveKit (`npm run stack:up` starts it); these defaults match `livekit-server --dev`.
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# LIVEKIT_PUBLIC_URL        # where browsers reach LiveKit; default is this page's host on port 7880
# KAKI_URL                  # where the AI attendees send transcript lines; default http://localhost:$PORT
# Tuning the AI attendees (all optional):
# NPC_RESPONSE_DELAY_MS=300         # quiet needed after you stop talking before they answer
# NPC_TEMPERATURE=0.8
# NPC_STT=azure                     # azure (default): the server recognises your speech; browser: Chrome recognises it, and you must open /demo?stt=browser
# NPC_STT_LOCALE=en-SG              # language for Azure speech recognition
# NPC_DEBUG_AUDIO_DIR=npc-audio      # save what the server heard of you as WAV files, to listen to
# NPC_SPEAKER_GAP_MS=700            # pause when a different character takes over
# NPC_VAD_LEAK_MARGIN=2             # while they talk you must be this many times louder than their echo; lower = easier to interrupt
# NPC_VAD_LEAK_CAP=0.06             # mic levels above this while they talk are taken to be you, not their echo; raise it only if your speakers are very loud
# NPC_VAD_MIN_LEVEL=0.015           # how loud you must be to count as talking (0-1 scale)
# NPC_VAD_GUARDED_MIN_LEVEL=0.03    # the same while they are talking: raise it if they cut themselves off
# NPC_VAD_START_MS=120
# NPC_VAD_GUARDED_START_MS=120      # loud time needed to count as talking over them; lower = quicker interruption
# NPC_VAD_HANGOVER_MS=500           # pause that counts as you having stopped talking
# NPC_DEBUG_VAD=1                   # log mic level, AI level, learned leak and bar twice a second while the AI talks
