# Copy to .env:  cp .env.example .env
# Fill in the required keys below, then run:  npm start
# The server loads this file on start, and variables already set in the shell win.
#
# Required: `npm start` stops and lists these if they are missing or empty in .env.
# required: KAKI_LLM_BASE_URL KAKI_LLM_API_KEY KAKI_LLM_MODEL AZURE_SPEECH_KEY AZURE_SPEECH_REGION
# Everything else is optional: the demo runs with these defaults.
PORT=3001
# Where the API server listens. 0.0.0.0 reaches phones on the Wi-Fi; 127.0.0.1 is this machine only.
# KAKI_BIND=0.0.0.0
# Dev routes are off by default and refused when KAKI_AUTH=1. npm run dev turns them on locally.
# KAKI_DEV_ROUTES=1
# An open (sign-in off) server may not bind a non-loopback address or publish a non-loopback
# KAKI_PUBLIC_URL unless this is set. npm run dev sets it for the local trusted demo; a public
# server should set KAKI_AUTH=1 instead. With KAKI_AUTH=1 over a public address, KAKI_PUBLIC_URL
# must be https (so session cookies are Secure) unless this is set.
# KAKI_ALLOW_OPEN=1
# Behind the cloud reverse proxy every request arrives from 127.0.0.1. Set this so rate limits use
# the right-most untrusted X-Forwarded-For address; the header is ignored when the direct peer is
# not loopback. Leave it unset when clients reach the server directly.
# KAKI_TRUST_PROXY=1

# Safe playtesting: set KAKI_DRAFT_ONLY=1 on BOTH the API/dev server and the NPC process (same value).
# Tasks are still drafted and can be reviewed, but approved actions and automatic wiki minutes are never sent
# to Gitea, Mattermost, Mailpit, Wiki.js or the calendar, and AI attendees do not auto-approve or retry.
# KAKI_DRAFT_ONLY=1

# Required: the shared LLM client (OpenAI-compatible, e.g. the school gateway). The AI attendees,
# the host and the wingman all use it.
KAKI_LLM_BASE_URL=
KAKI_LLM_API_KEY=
KAKI_LLM_MODEL=
# How long the model's reply may take: first chunk, between chunks, and the whole request (ms).
# KAKI_LLM_FIRST_CHUNK_MS=12000
# KAKI_LLM_IDLE_MS=10000
# KAKI_LLM_TIMEOUT_MS=20000
# Fallback LLM (OpenAI-compatible): used automatically when the primary fails. All three are needed.
# KAKI_LLM_FALLBACK_BASE_URL=
# KAKI_LLM_FALLBACK_API_KEY=
# KAKI_LLM_FALLBACK_MODEL=
# Reasoning control sends reasoning_effort ('none' for JSON replies and quick assessments). Unset keeps
# the old rule: on only for model names containing "deepseek". Accepts true/false or 1/0.
# KAKI_LLM_REASONING_CONTROL=
# KAKI_LLM_FALLBACK_REASONING_CONTROL=
# The notetaker runs in the background and may use a smarter, slower model than the AI attendees.
# The model falls back to KAKI_LLM_MODEL; the gateway and key fall back to the primary LLM.
# KAKI_NOTETAKER_LLM_MODEL=
# KAKI_NOTETAKER_LLM_BASE_URL=
# KAKI_NOTETAKER_LLM_API_KEY=
# KAKI_NOTETAKER_LLM_TIMEOUT_MS=60000
# KAKI_NOTETAKER_LLM_REASONING_CONTROL=
# Move the school gateway and the direct DeepSeek API between the primary and fallback slots:
# npm run llm:use -- school   (or: npm run llm:use -- direct)
# Company-search embeddings default to the fallback gateway, else the primary. Pin them before using
# llm:use (it refuses otherwise), so a swap never sends them to a gateway without the embedding model:
# KAKI_EMBED_BASE_URL=
# KAKI_EMBED_API_KEY=
# KAKI_EMBED_MODEL=bge-m3

# Host: play scenarios/<id>/replay/transcript.json instead of live audio, optionally sped up.
# KAKI_REPLAY=1
# KAKI_REPLAY_SPEED=10
# KAKI_CLOCK_SPEED=1
# KAKI_NOTETAKER_INTERVAL_MS=7000
# KAKI_AGENDA_ITEMS=2
# KAKI_AGENDA_PICK=            # comma-separated agenda titles or 0-based indexes; replaces the random draw

# Optional host sign-in. Set KAKI_HOST_EMAIL and KAKI_HOST_PASSWORD together, or neither.
# KAKI_AUTH=1
# KAKI_HOST_EMAIL=
# KAKI_HOST_PASSWORD=
# With sign-in on, the AI runner also needs this shared secret for its service channel; Start waits
# until the runner confirms it opened the meeting. Set the same value for the server and npm run npc.
# KAKI_SERVICE_TOKEN=
# POSTGRES_URL=postgres://kaki:kaki_dev_password@127.0.0.1:5433/kaki
# The same Postgres saves the meeting, notetaker progress and tasks, so a restart keeps the meeting.
# Unset means memory only. A saved meeting from another format stops the server; discard it with
# npm run meeting:reset. `npm start` wires this from docker/.env, so the demo needs no setup.
# The seed reads its own docker/.env (see docker/.env.example) for Postgres and the Gitea/Mattermost
# admin logins; the local demo defaults there are enough.

# Where phones should open the Kaki page; default is this machine's LAN address.
# KAKI_PUBLIC_URL=
# KAKI_WEB_PORT=5173

# Action: Gitea issues Kaki files after approval. Without all four, a Gitea task fails with a clear message.
# GITEA_TOKEN is generated by `npm run seed` into docker/.env, and `npm start` passes it to Kaki for you.
GITEA_URL=http://127.0.0.1:8082
GITEA_TOKEN=
GITEA_ORG=kopitiam
GITEA_REPO=kopitiam-pos

# Action: Mattermost posts Kaki sends after approval. Without all four, a Mattermost task fails with a clear message.
# MATTERMOST_TOKEN is generated by `npm run seed` into docker/.env, and `npm start` passes it to Kaki for you.
MATTERMOST_URL=http://127.0.0.1:8083
# Where a browser opens Mattermost. Defaults to MATTERMOST_URL, or to KAKI_PUBLIC_URL's host with
# Mattermost's own port. The server still logs in through MATTERMOST_URL. With sign-in on and an
# https KAKI_PUBLIC_URL this must be https (or MATTERMOST_URL itself must be https); the server
# refuses to start otherwise, because Secure cookies cannot authenticate an http redirect, unless
# KAKI_ALLOW_OPEN=1 explicitly allows the trusted demo.
# MATTERMOST_PUBLIC_URL=http://localhost:8083
MATTERMOST_TOKEN=
MATTERMOST_TEAM=kopitiam
MATTERMOST_CHANNEL=kopitiam-launch

# Action: emails Kaki sends after approval through the local Mailpit stack. Without all four, an email task fails with a clear message.
# The first three match the demo stack; EMAIL_FROM is the address Kaki sends from.
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_URL=http://127.0.0.1:8084
EMAIL_FROM=kaki@nanyangkopitiam.example

# Action: wiki pages Kaki publishes after approval (Wiki.js from the demo stack). Without all three, a wiki task fails with a clear message.
WIKI_URL=http://127.0.0.1:8081
WIKI_ADMIN_EMAIL=demo
WIKI_ADMIN_PASSWORD=demo

# Action: calendar events Kaki saves after approval (mock Radicale from the demo stack, no login, nothing real).
# People open an event at KAKI_PUBLIC_URL (or http://127.0.0.1:$PORT) + /api/calendar/<id>.
CALDAV_URL=http://127.0.0.1:5232

# Live demo meeting (`/demo`): the AI attendees run with `npm run npc`. They need the LLM above and Azure speech.
# Required: speech recognition and the AI voices.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# LiveKit (`npm run stack:up` starts it); these defaults match `livekit-server --dev`.
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# LIVEKIT_PUBLIC_URL        # where browsers reach LiveKit; default is this page's host on port 7880
# KAKI_URL                  # where the AI attendees send transcript lines; default http://localhost:$PORT
# Tuning the AI attendees (all optional):
# NPC_RESPONSE_DELAY_MS=300         # quiet needed after you stop talking before they answer
# NPC_TEMPERATURE=0.8
# How long the model thinks before each spoken line: none|low|medium|high (default none, the fastest).
# NPC_REASONING=
# NPC_STT=azure                     # azure (default): the server recognises your speech
# NPC_STT_LOCALE=en-SG              # language for Azure speech recognition
# NPC_DEBUG_AUDIO_DIR=npc-audio      # save what the server heard of you as WAV files, to listen to
# NPC_SPEAKER_GAP_MS=700            # pause when a different character takes over
# NPC_VAD_LEAK_MARGIN=2             # while they talk you must be this many times louder than their echo; lower = easier to interrupt
# NPC_VAD_LEAK_CAP=0.06             # mic levels above this while they talk are taken to be you, not their echo; raise it only if your speakers are very loud
# NPC_VAD_MIN_LEVEL=0.015           # how loud you must be to count as talking (0-1 scale)
# NPC_VAD_GUARDED_MIN_LEVEL=0.03    # the same while they are talking: raise it if they cut themselves off
# NPC_VAD_START_MS=120
# NPC_VAD_GUARDED_START_MS=120      # loud time needed to count as talking over them; lower = quicker interruption
# NPC_VAD_HANGOVER_MS=500           # pause that counts as you having stopped talking
# NPC_DEBUG_VAD=1                   # log mic level, AI level, learned leak and bar twice a second while the AI talks
# NPC_SENTENCE_GAP_MS=400           # pause between one character's sentences
# NPC_BARGE_IN_MS=900               # how long you must keep talking to cut a character off
# NPC_STT_MIN_CONFIDENCE=0.6        # Azure recognition results below this are ignored
# NPC_APPROVE_DELAY_MS=6000         # how long an AI colleague "reads" a draft before approving it
# NPC_MAX_HUMANS=2                  # cap on people in a human-only meeting; meetings with AI stand-ins always take one person
# KAKI_FAULT=control-garbled|slow-first|stall-mid|tts-fail   # show one failure on purpose
# SCENARIO=kopitiam                 # which folder under scenarios/ to run
# KAKI_AUTO_DISPATCH=0              # 0: Sam does not hand out tasks by himself; a person does it from the Kaki dock
# KAKI_MEETING_CODE=                # fix the code the second person must give, instead of a random one per meeting
# KAKI_REJOIN_GRACE_MS=120000       # keep an empty meeting this long for the same person to return; 0 resets at once

# Checks and playtests (optional).
# KAKI_PLAYTEST_URL=http://localhost:5173   # the copy `npm run playtest:live` drives; set it to test the cloud site
# KAKI_PLAYTEST_SOUND=1                     # hear the playtest audio (silent by default)
# EVAL_WINDOW_SECONDS=70                    # meeting seconds per pass in `npm run eval:notetaker`
# E2E_DEBUG=1                               # verbose logs from the LiveKit end-to-end test
# LIVEKIT_E2E=1                             # let the LiveKit end-to-end test run (needs the Docker stack)
